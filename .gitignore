.vscode/
*.code-workspace
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
*.env
docker-compose.override.yml

# Local dev data (compose.yml bind mounts + native DATA_DIR/CONFIG_DIR/TEMP_DIR defaults)
/data/
/config/
/temp/

# SQLite (belt-and-suspenders in case DB_PATH is ever pointed elsewhere)
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# App config (belt-and-suspenders in case CONFIG_PATH is ever pointed elsewhere)
config.conf

# Cython build artifacts (generated .c from .pyx; the built .so is already covered above)
ext/*.c

# Logs
*.log
logs/

# Misc
*.bak
*.tmp
