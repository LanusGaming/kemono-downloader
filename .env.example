# Copy this file to .env and fill in the values you need.
# .env is gitignored - never commit your real session cookie.

# Required: kemono session cookie value (the part after "session=" in your browser's cookie)
SESSION_COOKIE=

# Optional: hostname of the kemono-schema API to use, e.g. kemono.cr or a compatible mirror
# like pawchive.pw. Only the hostname is needed - base_url/api_base/referer are derived from it
# (see core/network.py). Useful if the default domain goes down, or if you need to point
# reconcile at a different mirror than the one you download from (older data may only exist
# on one of them - run reconcile once per domain against the same local DB, it's safe to
# repeat since already-recorded files are skipped). Defaults to kemono.cr.
DOMAIN=kemono.cr

# Optional: only needed if a mirror serves actual file downloads from a different host than
# DOMAIN (kemono.cr serves everything from one host, so leave these commented out there). For
# pawchive, files are served from a separate subdomain with a /data prefix inserted before the
# API's hash-bucket path:
# FILE_DOMAIN=file.pawchive.pw
# FILE_PATH_PREFIX=/data

# Optional: path (inside the container) to a file listing creator URLs to download, one per line.
# Leave empty to download your favorited creators instead. Ignored if CREATORS_FROM_DATA=true.
CREATOR_URL_FILE=

# Optional: set to true to auto-discover the creator list from existing folders in DATA_DIR
# instead of CREATOR_URL_FILE/favorites - matches folders named {name}_{service}_{id} (the
# convention File.get_folder_path() writes) and skips anything that doesn't fit (e.g. manually
# downloaded folders with no id). Takes priority over CREATOR_URL_FILE. Defaults to false.
CREATORS_FROM_DATA=false

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL). Defaults to INFO.
LOG_LEVEL=INFO

# Optional: currently unused by the download logic. Defaults to false.
DOWNLOAD_ALL=false

# Optional: currently unused by the download logic. Defaults to false.
SORT_BY_RECENCY=false

# Optional: set to true to rebuild file/post records from what's already on disk instead of
# downloading (see core/management/reconcile.py). Leave false/unset for normal operation.
RECONCILE=false
