# Copy this file to .env and fill in the values you need.
# .env is gitignored - never commit your real session cookie.

# Required: kemono session cookie value (the part after "session=" in your browser's cookie)
SESSION_COOKIE=

# Optional: path (inside the container) to a file listing creator URLs to download, one per line.
# Leave empty to download your favorited creators instead.
CREATOR_URL_FILE=

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL). Defaults to INFO.
LOG_LEVEL=INFO

# Optional: currently unused by the download logic. Defaults to false.
DOWNLOAD_ALL=false

# Optional: currently unused by the download logic. Defaults to false.
SORT_BY_RECENCY=false

# Optional: set to true to rebuild file/post records from what's already on disk instead of
# downloading (see core/management/reconcile.py). Leave false/unset for normal operation.
RECONCILE=false
