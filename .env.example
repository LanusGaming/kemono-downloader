# Copy this file to .env and fill in the values you need.
# .env is gitignored - never commit your real session cookie.

# Required: kemono session cookie value (the part after "session=" in your browser's cookie)
SESSION_COOKIE=

# Optional: only needed if a creator's ALLOWED_TYPES includes 'external' and they post Google
# Drive links. Free Google Cloud API key with the Drive API enabled - no OAuth/billing needed for
# reading publicly-shared ("anyone with the link") files/folders.
GOOGLE_API_KEY=
